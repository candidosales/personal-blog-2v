---
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import HeroIcons from './HeroIcons.svelte';
import Typer from './Typer.svelte';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const titleSegments = [
	{ text: `${t('hero.title1')} ` },
	{
		text: t('hero.title2'),
		class: 'font-newsreader italic tracking-normal',
	},
];
---

<div class='my-8 md:my-24 mx-auto max-w-6xl px-4' transition:name='hero'>
	<div class='mx-auto'>
		<h1
			class='tracking-tight text-blue-600 sm:text-lg md:text-2xl font-inclusive animate-fade-in-up'
		>
			<span class='block xl:inline'>{t('hero.introduction')}</span>
		</h1>
		<p
			class='subtitle mt-3 md:mt-5 text-blue-800 text-4xl sm:text-4xl md:text-6xl lg:text-7xl hero-title font-inclusive  animate-fade-in-up'
		>
			<Typer segments={titleSegments} client:load />
		</p>
		<HeroIcons />
	</div>
</div>

<style>
	.hero-title {
		letter-spacing: -0.06em;
	}
</style>
