        href="https://www.linkedin.com/in/candidosales/"
        title="See more about my experiences in my Linkedin"
        target="_blank"
        ><Linkedin class="h-4 w-4 me-2" />{t("about.seeMoreLinkedin")}

        <ArrowRight class="overflow-visible ms-3 text-white" />
      </a>
    </div>
    <div class="my-16 mx-auto max-w-6xl slide-fade-in">
      <div class="p-6">
        <div
          class="flex flex-col md:flex-row mx-auto justify-center items-center md:items-start"
        >
          <Image
            src="/quotes/anthony-bourdain.webp"
            width={56}
            height={56}
            alt=""
            class="w-14 h-14 rounded-full mbe-2 md:mbe-0 me-0 md:me-4"
            loading="lazy"
            decoding="async"
          />
          <blockquote class="text-center md:text-left font-inclusive">
            <p class="text-blue-800 mbe-2 md:mbe-0">Anthony Bourdain</p>
            <p class="max-w-120 mx-auto text-xl font-medium text-blue-600">
