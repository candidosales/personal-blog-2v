      transition:name="content"
    >
      <div class="flex items-center justify-center mbe-8">
        <div class="polaroid-stack relative w-full max-w-md h-96 sm:h-115">
          <div
            class="polaroid-slot pointer-events-none absolute inset-s-1/2 inset-bs-1/2 z-10 -translate-x-1/2 -translate-y-1/2"
          >
            <figure
              data-role="back"
              class="w-72 h-85 polaroid pointer-events-auto cursor-pointer bg-white p-3 pbe-2 rounded-md shadow-xl"
            >
              <Image
                class="w-72 h-72 object-cover rounded-sm"
                alt="Banff National Park, Canada"
                width={400}
                height={400}
                src="/me-500.png"
                loading={"eager"}
              />
              <figcaption
                class="polaroid-caption mbs-2 text-center text-slate-600"
              >
                Banff National Park, Canada
              </figcaption>
            </figure>
          </div>
          <div
            class="polaroid-slot pointer-events-none absolute inset-s-1/2 inset-bs-1/2 z-20 -translate-x-1/2 -translate-y-1/2"
