          {" "}
          {t("about.piece11")}
        </p>
      </div>
    </div>
    <h2
      class="text-3xl leading-8 font-medium tracking-tight text-blue-800 sm:text-4xl mbs-20 slide-fade-in"
    >
      {t("about.title2")}
    </h2>
    <ol
      class="relative mbs-10 slide-fade-in before:absolute before:inset-y-8 before:start-6 before:w-0.5 before:bg-blue-100"
    >
      {
        experience.map((e, i) => (
          <li class="relative flex gap-6 py-5">
