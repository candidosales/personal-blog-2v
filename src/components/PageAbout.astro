            class="underline underline-offset-4 after:content-['_↗']"
            href="https://www.smile.io/"
            title="Visit Smile.io"
            target="_blank">Smile.io</a
          >
          {" "}{t("about.piece7")}{" "}
        </p>

        <p>
          {t("about.piece8")}{" "}
          <a
            class="underline underline-offset-4 after:content-['_↗']"
            href="https://geleiatotal.com.br/"
            title="Visit Geleia Total"
            target="_blank">Geleia Total</a
          >
          {" "}{t("about.and")}{" "}
          <a
            class="underline underline-offset-4 after:content-['_↗']"
            href="https://www.turismopiaui.com/"
            title="Visit Turismo Piauí"
            target="_blank">Turismo Piauí</a
          >
          {" "}{t("about.piece9")}{" "}
