            </figure>
          </div>
        </div>
      </div>
      <div class="space-y-4 text-blue-800 text-lg">
        <p>
          {t("about.piece1")}{" "}
          {t("about.piece2")}
        </p>
        <p>
          {t("about.piece6")}{" "}
