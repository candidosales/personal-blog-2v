    title: "Intermediate Software Engineer",
    country: "🇨🇦",
  },
  {
    company: {
      name: "Cisco",
      image: "/companies/cisco.jpeg",
      url: "https://www.cisco.com/",
    },
    period: "Feb 2022 - Oct 2024",
    title: "Senior Software Engineer",
    country: "🇨🇦",
  },
