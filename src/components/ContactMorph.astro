---
import ArrowRight from '@components/icons/ArrowRight.svelte';
import IconAt from '@components/icons/IconAt.svelte';
import { getLangFromUrl, useTranslations } from '@i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
---

<div class='morph font-inclusive' data-open='false' data-error={t('services.contact.error')}>
	<button
		class='bg-blue-700 text-white hover:bg-blue-900 rounded-full py-3 px-6 flex items-center justify-center font-medium motion-safe:transition-[color,background-color,scale] active:scale-97 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700'
		type='button'
		aria-expanded='false'
		><IconAt class='h-4 w-4 me-2' />
		{t('services.contactMe')}
		<ArrowRight class='overflow-visible ms-3 text-white' />
	</button>
	<div class='morph-body'>
		<div class='overflow-hidden p-1'>
			<div class='flex items-end gap-3'>
				<img src='/me-2.webp' alt='' class='size-8 rounded-full object-cover flex-none' />
				<p class='bubble'>{t('services.contact.greeting')}</p>
			</div>
			<form class='composer mbs-4'>
				<textarea name='message' rows='3' maxlength='1000' placeholder={t('services.contact.message')} required></textarea>
				<input name='email' type='email' maxlength='254' placeholder='you@email.com' autocomplete='email' required />
				<footer><span data-count>0 / 1,000</span><button type='submit' disabled>{t('services.contact.send')}</button></footer>
				<p class='status' role='status' hidden>{t('services.contact.sent')}</p>
			</form>
		</div>
	</div>
</div>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('.morph')) {
		const open = root.querySelector<HTMLButtonElement>(':scope > button')!;
		const form = root.querySelector('form')!;
		const msg = form.elements.namedItem('message') as HTMLTextAreaElement;
		const count = form.querySelector('[data-count]')!;
		const send = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
		const status = form.querySelector<HTMLElement>('.status')!;

		open.addEventListener('click', () => {
			root.dataset.open = 'true';
			open.setAttribute('aria-expanded', 'true');
			msg.focus({ preventScroll: true });
		});
		form.addEventListener('input', () => {
			count.textContent = `${msg.value.length.toLocaleString('en')} / 1,000`;
			send.disabled = !form.checkValidity();
		});
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			send.disabled = true;
			const res = await fetch('/api/contact', {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify(Object.fromEntries(new FormData(form))),
			}).catch(() => null);
			if (res?.ok) {
				for (const el of form.querySelectorAll<HTMLElement>('textarea, input, footer')) el.hidden = true;
			} else {
				status.textContent = root.dataset.error!;
				send.disabled = false;
			}
			status.hidden = false;
		});
	}
</script>

<style>
	.morph {
		display: grid;
		justify-items: center;
		inline-size: min(36rem, 100%);
		.morph-body {
			display: grid;
			grid-template-rows: 0fr;
			inline-size: 100%;
			opacity: 0;
			transition: grid-template-rows 300ms cubic-bezier(0.2, 0, 0, 1), opacity 200ms;
		}
		&[data-open='true'] {
			> button { display: none; }
			.morph-body { grid-template-rows: 1fr; opacity: 1; }
		}
	}
	.bubble {
		max-inline-size: 85%;
		padding: 0.625rem 0.875rem;
		border-radius: 1.25rem 1.25rem 1.25rem 0.25rem;
		background: var(--color-slate-100);
		color: var(--color-slate-800);
		line-height: 1.45;
	}
	.composer {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--color-slate-200);
		border-radius: 1rem;
		background: white;
		box-shadow: 0 8px 24px -12px rgb(15 23 42 / 0.2);
		&:focus-within { border-color: var(--color-blue-700); }
		textarea, input {
			padding: 0.875rem 1rem;
			background: transparent;
			outline: none;
			resize: none;
			color: var(--color-slate-900);
		}
		input { border-block: 1px solid var(--color-slate-100); }
		footer {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0.5rem 0.5rem 0.5rem 1rem;
			font-size: 0.875rem;
			color: var(--color-slate-400);
			font-variant-numeric: tabular-nums;
		}
		footer button {
			border-radius: 999px;
			padding: 0.5rem 1.25rem;
			background: var(--color-blue-700);
			color: white;
			font-weight: 500;
			transition: opacity 150ms;
			&:disabled { opacity: 0.4; }
		}
		[hidden] { display: none; }
		.status { padding: 1rem; text-align: center; color: var(--color-blue-800); }
	}
</style>
