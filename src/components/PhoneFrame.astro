---
// Vector phone frame drawn in millimetres and scaled by container width.
// iphone: iPhone 18 Pro dimensional drawing (case 71.85 × 150.01, display 66.57 × 144.73, 402 × 874 pt).
// android: approximation of a Pixel 9 class phone (1080 × 2424 px screen, centred punch-hole camera).
export interface Props {
	src: string;
	alt: string;
	device: 'iphone' | 'android';
	class?: string;
	style?: string;
}
const { src, alt, device, class: cls = '', style } = Astro.props;

const d =
	device === 'iphone'
		? { w: 71.85, h: 150.01, sw: 66.57, sh: 144.73, r: 12.7, sr: 10.1, left: [[34.28, 6.9], [48.43, 11.2], [62.63, 11.2]], right: [[55.53, 17.7]] }
		: { w: 72, h: 155.6, sw: 67.2, sh: 150.8, r: 9.5, sr: 7.4, left: [], right: [[38, 11], [60, 22]] };
const inset = { x: (d.w - d.sw) / 2, y: (d.h - d.sh) / 2 };
const mm = (v: number) => `calc(${v} * var(--k))`;
---

<div class={`phone ${cls}`} style={style}>
	<div class='case' style={`--k: calc(100cqw / ${d.w}); aspect-ratio: ${d.w} / ${d.h}; border-radius: ${mm(d.r)}`}>
		{d.left.map(([c, l]) => <i class='btn' style={`inset-inline-start:${mm(-0.45)};inset-block-start:${mm(c - l / 2)};block-size:${mm(l)}`} />)}
		{d.right.map(([c, l]) => <i class='btn' style={`inset-inline-end:${mm(-0.45)};inset-block-start:${mm(c - l / 2)};block-size:${mm(l)}`} />)}
		<div class='screen' style={`inset:${mm(inset.y)} ${mm(inset.x)};border-radius:${mm(d.sr)}`}>
			<img src={src} alt={alt} loading='lazy' decoding='async' />
			{device === 'iphone'
				? <i class='cam' style={`inset-inline-start:${mm(35.925 - inset.x - 7.83)};inset-block-start:${mm(7.99 - inset.y - 3.035)};inline-size:${mm(15.66)};block-size:${mm(6.07)}`} />
				: <i class='cam' style={`inset-inline-start:calc(50% - ${mm(1.85)});inset-block-start:${mm(2.1)};inline-size:${mm(3.7)};block-size:${mm(3.7)}`} />}
		</div>
	</div>
</div>

<style>
	.phone {
		container-type: inline-size;
	}
	.case {
		position: relative;
		isolation: isolate;
		inline-size: 100%;
		background: linear-gradient(145deg, #3a3f47, #15181d 45%, #2a2e35);
		box-shadow:
			inset 0 0 0 calc(0.35 * var(--k)) #555b64,
			0 24px 48px -12px rgb(15 23 42 / 0.45);
	}
	.btn {
		position: absolute;
		inline-size: calc(0.9 * var(--k));
		border-radius: calc(0.4 * var(--k));
		background: #2a2e35;
		z-index: -1;
	}
	.screen {
		position: absolute;
		overflow: hidden;
		background: #000;
	}
	.screen img {
		display: block;
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
		object-position: top;
	}
	.screen::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: linear-gradient(115deg, rgb(255 255 255 / 0.12), transparent 35%);
		pointer-events: none;
	}
	.cam {
		position: absolute;
		z-index: 1;
		border-radius: 999px;
		background: #000;
	}
</style>
